    // Atualiza os textos dinamicamente na tela do simulador para dar feedback visual
    document.getElementById('sim-map-title').textContent = `Mapa de Risco Projetado — ${month} (≥ 5mm)`;
    document.getElementById('sim-alert-title').textContent = `Alerta Crítico: Sazonalidade de ${month} detectada`;
    
    // Efeito visual de recarregar o card
    const resultArea = document.getElementById('sim-result');
    resultArea.style.opacity = '0.5';
    setTimeout(() => {
      resultArea.style.opacity = '1';
    }, 300);
  }
</script>

